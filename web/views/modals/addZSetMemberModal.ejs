<div id="addZSetMemberModal" class="modal fade">
  <div class="modal-dialog modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header">
    <button type="button" class="btn-close" aria-label="Close" data-bs-dismiss="modal"></button>
    <h3>Add Member</h3>
  </div>
  <div class="modal-body">
    <form id="addZSetMemberForm" action="apiv2/zset/member/add" method="POST" class="form-vertical">
      <input id="addZSetKey" name="key" type="hidden"/>
      <label class="control-label" for="addZSetScore">Score</label>
      <input id="addZSetScore" name="score" type="text" class="form-control"/>
      <label class="control-label" for="addSetMemberName">Value</label>
      <textarea id="addZSetMemberName" name="value" class="modal-content-width form-control" style="height: 250px;"></textarea>
      <label class="checkbox"><input type="checkbox" id="addZSetMemberIsJson" name="isJson">Validate as JSON</label>
      <input id="addZSetConnectionId" name="connectionId" type="hidden"/>
    </form>
  </div>
  <div class="modal-footer">
    <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    <button id="saveZMemberButton" class="btn btn-primary" data-loading-text="<i class='bi bi-arrow-clockwise'></i> Saving..." onclick="$('#addZSetMemberForm').trigger('submit')">Save</button>
  </div>
  </div></div>
</div>
<script>
  setupEditDataModals('addZSetMemberForm', 'saveZMemberButton');
  setupJsonInputValidator('addZSetMemberIsJson', 'addZSetMemberName')
  registerModalFocus('addZSetMemberModal', 'addZSetScore');
</script>
